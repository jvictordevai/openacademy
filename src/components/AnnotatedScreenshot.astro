---
interface Annotation {
  x: number; // percent 0-100
  y: number; // percent 0-100
  label: string;
  text?: string;
}

interface Props {
  src?: string;
  alt: string;
  caption?: string;
  href?: string;
  source: string;
  annotations?: Annotation[];
  ratio?: 'aspect-[16/9]' | 'aspect-[4/3]' | 'aspect-[21/9]' | 'aspect-video';
}

const {
  src,
  alt,
  caption,
  href,
  source,
  annotations = [],
  ratio = 'aspect-[16/9]',
} = Astro.props;
---

<figure class="not-prose my-8">
  <a
    href={href ?? '#'}
    target={href ? '_blank' : undefined}
    rel={href ? 'noreferrer' : undefined}
    class="group block rounded-2xl border border-white/10 bg-ink-900/50 overflow-hidden hover:border-white/20 transition relative"
  >
    <div class={`relative ${ratio} overflow-hidden`}>
      {src ? (
        <img src={src} alt={alt} class="w-full h-full object-cover" loading="lazy" />
      ) : (
        <div class="absolute inset-0 grid-bg">
          <div class="absolute inset-0 grid place-items-center">
            <div class="text-center max-w-md px-6">
              <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400 mb-2">
                Captura de tela
              </div>
              <div class="font-display text-lg text-ink-200 font-medium">
                {alt}
              </div>
              <div class="font-mono text-[11px] text-accent-blue mt-3">{source}</div>
            </div>
          </div>
          <div class="absolute inset-0 [background:radial-gradient(circle_at_30%_20%,oklch(72%_0.18_250/0.08),transparent_60%)]"></div>
          <div class="absolute inset-0 [background:radial-gradient(circle_at_80%_80%,oklch(70%_0.22_295/0.06),transparent_60%)]"></div>
        </div>
      )}

      {/* Annotation pins */}
      {annotations.map((a, i) => (
        <div
          class="absolute z-10 -translate-x-1/2 -translate-y-1/2"
          style={`left:${a.x}%;top:${a.y}%`}
        >
          <div class="relative group/pin">
            <div class="w-7 h-7 rounded-full bg-accent-blue text-ink-100 font-mono font-bold text-xs grid place-items-center shadow-lg ring-4 ring-accent-blue/30 animate-pulse">
              {i + 1}
            </div>
            <div class="absolute left-full ml-2 top-1/2 -translate-y-1/2 whitespace-nowrap pointer-events-none opacity-0 group-hover/pin:opacity-100 transition">
              <div class="bg-ink-950/95 backdrop-blur-md text-ink-100 text-xs font-medium px-3 py-1.5 rounded-lg border border-white/15 shadow-xl">
                {a.label}
              </div>
            </div>
          </div>
        </div>
      ))}

      {href && (
        <div class="absolute top-3 right-3 z-20 glass rounded-full px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-ink-200 opacity-0 group-hover:opacity-100 transition">
          Abrir ↗
        </div>
      )}
    </div>
  </a>

  {/* Legend */}
  {annotations.length > 0 && (
    <ol class="not-prose mt-3 grid sm:grid-cols-2 gap-2 pl-0 list-none">
      {annotations.map((a, i) => (
        <li class="flex items-start gap-2.5 text-[13px] text-ink-300 leading-snug">
          <span class="shrink-0 w-5 h-5 rounded-full bg-accent-blue/15 text-accent-blue font-mono font-bold text-[10px] grid place-items-center mt-0.5">
            {i + 1}
          </span>
          <span>
            <strong class="text-ink-100">{a.label}</strong>
            {a.text && <span class="text-ink-400"> — {a.text}</span>}
          </span>
        </li>
      ))}
    </ol>
  )}

  {caption && (
    <figcaption class="mt-3 text-[13px] text-ink-400 leading-relaxed">
      {caption}
      <span class="text-ink-700 mx-2">·</span>
      <span class="font-mono text-[11px] text-ink-400">fonte: {source}</span>
    </figcaption>
  )}
</figure>
