---
interface Props {
  items: string[];
  title?: string;
}

const { items, title = 'Pegadinhas' } = Astro.props;
---

<section class="not-prose my-10 rounded-2xl border border-accent-ember/25 bg-accent-ember/[0.04] p-6">
  <div class="flex items-center gap-2 mb-4">
    <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent-ember">{title}</span>
    <span class="h-px flex-1 bg-accent-ember/20"></span>
  </div>
  <ul class="space-y-2.5 pl-0 list-none">
    {
      items.map((item) => (
        <li class="flex gap-3 text-[15px] leading-relaxed text-ink-200">
          <span class="text-accent-ember font-mono shrink-0 mt-0.5" aria-hidden="true">!</span>
          <span set:html={item} />
        </li>
      ))
    }
  </ul>
</section>
