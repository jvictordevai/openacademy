---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  href?: string;
  source: string;
  ratio?: string;
}

const { src, alt, caption, href, source, ratio = 'aspect-[16/9]' } = Astro.props;
---

<figure class="my-8">
  <a
    href={href ?? '#'}
    target={href ? '_blank' : undefined}
    rel={href ? 'noreferrer' : undefined}
    class="group block rounded-2xl border border-white/10 bg-ink-900/50 overflow-hidden hover:border-white/20 transition relative"
  >
    {src ? (
      <img src={src} alt={alt} class={`w-full ${ratio} object-cover`} loading="lazy" />
    ) : (
      <div class={`relative ${ratio} grid-bg`}>
        <div class="absolute inset-0 grid place-items-center">
          <div class="text-center">
            <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400 mb-2">
              Captura de tela
            </div>
            <div class="font-display text-lg text-ink-200 font-medium px-6">
              {alt}
            </div>
            <div class="font-mono text-[11px] text-accent-blue mt-3">
              {source}
            </div>
          </div>
        </div>
        <div class="absolute inset-0 [background:radial-gradient(circle_at_30%_20%,oklch(72%_0.18_250/0.08),transparent_60%)]"></div>
        <div class="absolute inset-0 [background:radial-gradient(circle_at_80%_80%,oklch(70%_0.22_295/0.06),transparent_60%)]"></div>
      </div>
    )}
    {href && (
      <div class="absolute top-3 right-3 glass rounded-full px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-ink-200 opacity-0 group-hover:opacity-100 transition">
        Abrir ↗
      </div>
    )}
  </a>
  {caption && (
    <figcaption class="mt-3 text-[13px] text-ink-400 leading-relaxed">
      {caption}
      <span class="text-ink-700 mx-2">·</span>
      <span class="font-mono text-[11px] text-ink-400">fonte: {source}</span>
    </figcaption>
  )}
</figure>
