---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  sourceUrl?: string;
  sourceLabel?: string;
}

const { src, alt, caption, sourceUrl, sourceLabel } = Astro.props;
---

<figure class="my-8">
  <div class="rounded-2xl overflow-hidden border border-white/10 bg-ink-900/60 relative group">
    <img src={src} alt={alt} class="w-full h-auto block" loading="lazy" />
    {
      sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noreferrer"
          class="absolute top-3 right-3 glass-strong rounded-full px-3 py-1 text-[10px] font-mono uppercase tracking-wider text-ink-200 hover:text-ink-100 opacity-0 group-hover:opacity-100 transition"
        >
          ↗ fonte
        </a>
      )
    }
  </div>
  {
    (caption || sourceLabel) && (
      <figcaption class="mt-3 text-sm text-ink-400 flex items-center gap-2 flex-wrap">
        {caption && <span>{caption}</span>}
        {sourceLabel && sourceUrl && (
          <a
            href={sourceUrl}
            target="_blank"
            rel="noreferrer"
            class="font-mono text-[11px] uppercase tracking-wider text-accent-blue hover:underline"
          >
            {sourceLabel} ↗
          </a>
        )}
      </figcaption>
    )
  }
</figure>
