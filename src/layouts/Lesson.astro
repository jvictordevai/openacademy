---
import Base from './Base.astro';
import ModuleSidebar from '../components/ModuleSidebar.astro';
import LessonTOC from '../components/LessonTOC.astro';
import SourceList from '../components/SourceList.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TaskBox from '../components/TaskBox.astro';
import { getCollection } from 'astro:content';

interface LessonTask {
  prompt: string;
  criteria: string;
  minutes: number;
}

interface Props {
  frontmatter: {
    title: string;
    module: string;
    order: number;
    description: string;
    minutes: number;
    difficulty: 'iniciante' | 'intermediario' | 'avancado';
    sources: Array<{ label: string; url: string }>;
    tags: string[];
    task?: LessonTask;
  };
  headings: Array<{ depth: number; slug: string; text: string }>;
  slug: string;
}

const { frontmatter, headings, slug } = Astro.props;

const allModules = await getCollection('modules');
const currentModule = allModules.find((m) => m.data.id === frontmatter.module);

const allLessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const sameModuleLessons = allLessons
  .filter((l) => l.data.module === frontmatter.module)
  .sort((a, b) => a.data.order - b.data.order);

const currentIdx = sameModuleLessons.findIndex((l) => l.slug === slug);
const prev = currentIdx > 0 ? sameModuleLessons[currentIdx - 1] : null;
const next = currentIdx < sameModuleLessons.length - 1 ? sameModuleLessons[currentIdx + 1] : null;
const lessonPositionLabel = `${currentIdx + 1} de ${sameModuleLessons.length}`;

const difficultyLabel = {
  iniciante: 'Iniciante',
  intermediario: 'Intermediário',
  avancado: 'Avançado',
}[frontmatter.difficulty];
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <ReadingProgress />

  <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] focus:bg-accent-blue focus:text-ink-100 focus:px-4 focus:py-2 focus:rounded-lg focus:font-medium">
    Pular para o conteúdo
  </a>

  <div class="max-w-7xl mx-auto px-6">
    <div class="flex gap-10">
      <ModuleSidebar currentLessonSlug={slug} currentModule={frontmatter.module} />

      <article id="content" class="flex-1 min-w-0 max-w-3xl pb-16">
        <header class="mb-12">
          {
            currentModule && (
              <Breadcrumb
                crumbs={[
                  { label: 'Módulos', href: '/modulos' },
                  { label: currentModule.data.title, href: `/modulos/${currentModule.data.id}` },
                  { label: frontmatter.title },
                ]}
              />
            )
          }

          <h1 class="font-display text-4xl md:text-5xl font-bold text-ink-100 leading-[1.05] tracking-tight">
            {frontmatter.title}
          </h1>
          <p class="mt-4 text-lg text-ink-300 leading-relaxed">{frontmatter.description}</p>

          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-[12px] font-mono uppercase tracking-wider text-ink-400">
            <span class="flex items-center gap-1.5">
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.2" />
                <path d="M6 3v3l2 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              </svg>
              {frontmatter.minutes} min
            </span>
            <span class="text-ink-700">·</span>
            <span>{difficultyLabel}</span>
            <span class="text-ink-700">·</span>
            <span class="lg:hidden">{lessonPositionLabel}</span>
            <span class="hidden lg:inline">{frontmatter.tags.slice(0, 3).join(' · ')}</span>
          </div>
        </header>

        <div class="prose-deck">
          <slot />
        </div>

        {frontmatter.task && (
          <TaskBox
            prompt={frontmatter.task.prompt}
            criteria={frontmatter.task.criteria}
            minutes={frontmatter.task.minutes}
            lessonSlug={slug}
          />
        )}

        <SourceList sources={frontmatter.sources} />

        <nav class="mt-14 pt-6 border-t border-white/10 grid grid-cols-2 gap-3" aria-label="Navegação entre lições">
          {
            prev ? (
              <a
                href={`/licoes/${prev.slug}`}
                class="group rounded-2xl p-4 border border-white/5 hover:border-white/10 hover:bg-white/[0.02] transition"
              >
                <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400 mb-1.5 group-hover:text-accent-blue transition">
                  ← Anterior
                </div>
                <div class="text-ink-200 group-hover:text-ink-100 font-medium text-sm leading-snug">
                  {prev.data.title}
                </div>
              </a>
            ) : (
              <div />
            )
          }
          {
            next ? (
              <a
                href={`/licoes/${next.slug}`}
                class="group rounded-2xl p-4 border border-white/5 hover:border-white/10 hover:bg-white/[0.02] transition text-right"
              >
                <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400 mb-1.5 group-hover:text-accent-blue transition">
                  Próxima →
                </div>
                <div class="text-ink-200 group-hover:text-ink-100 font-medium text-sm leading-snug">
                  {next.data.title}
                </div>
              </a>
            ) : (
              <div />
            )
          }
        </nav>
      </article>

      <LessonTOC headings={headings} />
    </div>
  </div>
</Base>
