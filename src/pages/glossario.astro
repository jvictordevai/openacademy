---
import Base from '../layouts/Base.astro';
import { glossary } from '../lib/glossary';

const sorted = [...glossary].sort((a, b) =>
  a.term.localeCompare(b.term, 'pt-BR', { sensitivity: 'base' }),
);

const letters = Array.from(
  new Set(sorted.map((g) => g.term.charAt(0).toUpperCase()))
).sort();
---

<Base
  title="Glossário"
  description={`${glossary.length} termos essenciais de IA, prompt engineering e ferramentas usadas na imersão, explicados em uma frase.`}
>
  <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] focus:bg-accent-blue focus:text-ink-100 focus:px-4 focus:py-2 focus:rounded-lg focus:font-medium">
    Pular para o conteúdo
  </a>

  <section class="relative max-w-5xl mx-auto px-6 pt-20 pb-12" id="content">
    <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-3">
      {glossary.length} termos · A-Z
    </div>
    <h1 class="font-display text-5xl md:text-7xl font-bold leading-[0.95] tracking-tight">
      Glossário.
    </h1>
    <p class="mt-6 text-xl text-ink-300 max-w-2xl leading-relaxed">
      Os termos que você vai ouvir na imersão e em conversas sobre IA, traduzidos em uma frase. Cada um com fonte oficial quando aplicável.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-8 sticky top-20 z-20 bg-ink-950/80 backdrop-blur-md py-4">
    <div class="glass rounded-2xl p-3">
      <input
        id="glossary-search"
        type="search"
        placeholder="Buscar termo…"
        aria-label="Buscar termo no glossário"
        class="w-full bg-transparent text-ink-100 placeholder:text-ink-400 outline-none px-3 py-2 font-mono text-sm"
      />
    </div>
    <nav class="mt-3 flex flex-wrap gap-1.5" aria-label="Navegar por letra">
      {
        letters.map((l) => (
          <a
            href={`#letra-${l}`}
            class="font-mono text-[11px] uppercase tracking-wider rounded-md w-7 h-7 grid place-items-center border border-white/10 bg-white/[0.02] text-ink-300 hover:text-ink-100 hover:border-accent-blue/40 hover:bg-accent-blue/5 transition"
          >
            {l}
          </a>
        ))
      }
    </nav>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div id="glossary-list" class="space-y-1">
      {
        letters.map((letter) => {
          const items = sorted.filter((g) => g.term.charAt(0).toUpperCase() === letter);
          return (
            <div data-letter={letter}>
              <h2
                id={`letra-${letter}`}
                class="font-display text-2xl font-bold text-ink-200 mt-10 mb-3 pb-2 border-b border-white/5 scroll-mt-32"
              >
                {letter}
              </h2>
              <div class="grid md:grid-cols-2 gap-3">
                {items.map((t) => (
                  <article
                    class="glossary-card glass rounded-2xl p-5 border border-white/5"
                    data-term={t.term.toLowerCase()}
                    data-short={t.short.toLowerCase()}
                  >
                    <h3 class="font-display text-lg font-semibold text-ink-100 leading-tight">
                      {t.term}
                    </h3>
                    <p class="mt-2 text-ink-300 text-[14px] leading-relaxed">{t.short}</p>
                    {t.long && (
                      <details class="mt-3 group">
                        <summary class="cursor-pointer list-none flex items-center gap-1 text-[11px] font-mono uppercase tracking-wider text-ink-400 hover:text-ink-200 transition">
                          <span class="chevron transition-transform group-open:rotate-90 text-xs">›</span>
                          <span>Mais detalhe</span>
                        </summary>
                        <p class="mt-2 text-ink-300 text-[13.5px] leading-relaxed">{t.long}</p>
                      </details>
                    )}
                    <div class="mt-3 flex flex-wrap gap-1.5 items-center">
                      {t.related?.map((r) => (
                        <a
                          href={`#${r.toLowerCase().replace(/\s+/g, '-')}`}
                          class="text-[10px] font-mono uppercase tracking-wider rounded-full px-2 py-0.5 bg-white/[0.04] text-ink-400 hover:text-ink-100 hover:bg-white/[0.08] transition"
                        >
                          {r}
                        </a>
                      ))}
                      {t.source && (
                        <a
                          href={t.source.url}
                          target="_blank"
                          rel="noreferrer"
                          class="text-[10px] font-mono uppercase tracking-wider rounded-full px-2 py-0.5 bg-accent-blue/10 text-accent-blue hover:bg-accent-blue/15 transition ml-auto"
                        >
                          {t.source.label} ↗
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
    <div id="empty-state" class="hidden text-center text-ink-400 py-12">
      Nenhum termo encontrado.
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById('glossary-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.glossary-card'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-letter]'));
  const emptyState = document.getElementById('empty-state');

  function filter(q: string) {
    const query = q.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const term = card.dataset.term ?? '';
      const short = card.dataset.short ?? '';
      const match = !query || term.includes(query) || short.includes(query);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    groups.forEach((g) => {
      const hasVisible = Array.from(g.querySelectorAll<HTMLElement>('.glossary-card')).some(
        (c) => c.style.display !== 'none',
      );
      g.style.display = hasVisible ? '' : 'none';
    });
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
  }

  input?.addEventListener('input', (e) => {
    filter((e.target as HTMLInputElement).value);
  });
</script>
