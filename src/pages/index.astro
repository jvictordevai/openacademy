---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { GlobeScene } from '../scenes/GlobeScene';
import { HubScene } from '../scenes/HubScene';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const lessons = await getCollection('lessons');

const stats = [
  { label: 'Módulos', value: String(modules.length) },
  { label: 'Lições publicadas', value: String(lessons.length) },
  { label: 'Conteúdo aberto', value: '100%' },
  { label: 'Custo de acesso', value: 'R$ 0' },
];
---

<Base title="openacademy">
  <!-- HERO -->
  <section class="relative min-h-[80vh] overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-70">
      <GlobeScene client:only="react" />
    </div>
    <div class="absolute inset-0 z-[1] grid-bg pointer-events-none"></div>
    <div class="absolute inset-0 z-[2] [background:radial-gradient(ellipse_at_center,transparent_30%,oklch(10%_0.02_260)_100%)] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 pt-32 pb-24">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue">
            Imersão IA · Para Empresários
          </span>
          <span class="h-px w-12 bg-accent-blue/40"></span>
        </div>

        <h1 class="font-display text-[clamp(3rem,7vw,7rem)] leading-[0.95] tracking-tight font-bold">
          A documentação <span class="gradient-text glow-text">aberta</span> da<br />
          Imersão IA.
        </h1>

        <p class="mt-8 text-xl md:text-2xl text-ink-300 max-w-2xl leading-relaxed">
          Vire dado em decisão. Planilha em dashboard. Ideia em app interno.
          Sem programador no meio.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="/modulos"
            class="inline-flex items-center gap-2 rounded-full px-6 py-3 bg-gradient-to-r from-accent-blue to-accent-violet text-ink-100 font-medium hover:brightness-110 transition"
          >
            Começar pelos módulos
            <span class="font-mono">→</span>
          </a>
          <a
            href="/modulos/m02"
            class="inline-flex items-center gap-2 rounded-full px-6 py-3 glass text-ink-200 font-medium hover:text-ink-100 transition"
          >
            Engenharia de prompt
          </a>
        </div>

        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl">
          {
            stats.map((s) => (
              <div class="glass rounded-2xl p-5 border border-white/5">
                <div class="font-display text-3xl font-bold text-ink-100">{s.value}</div>
                <div class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400 mt-1">{s.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU LEARN -->
  <section class="relative max-w-7xl mx-auto px-6 py-24">
    <div class="max-w-4xl mb-14">
      <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-3">
        O que você vai aprender
      </div>
      <h2 class="font-display text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight">
        Pouca teoria.<br />
        Muito que <span class="gradient-text">você usa segunda-feira.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {
        modules.map((m) => (
          <a
            href={`/modulos/${m.data.id}`}
            class="group glass rounded-3xl p-6 border border-white/5 hover:border-white/10 transition relative overflow-hidden"
          >
            <div
              class="absolute -top-12 -right-12 w-44 h-44 rounded-full blur-3xl opacity-20 group-hover:opacity-40 transition"
              style={`background:${m.data.color}`}
            />
            <div class="relative">
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400">
                  Módulo {String(m.data.order).padStart(2, '0')}
                </span>
                <span
                  class="w-2 h-2 rounded-full"
                  style={`background:${m.data.color}`}
                />
              </div>
              <h3 class="font-display text-2xl font-semibold text-ink-100 leading-tight">
                {m.data.title}
              </h3>
              <p class="mt-3 text-ink-400 text-[15px] leading-relaxed">{m.data.description}</p>
              <div class="mt-5 inline-flex items-center gap-2 text-sm text-ink-300 group-hover:text-ink-100 transition">
                Abrir módulo <span class="font-mono">→</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ECOSYSTEM -->
  <section class="relative max-w-7xl mx-auto px-6 py-24">
    <div class="relative grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-3">
          A stack
        </div>
        <h2 class="font-display text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight">
          Três camadas.<br /><span class="gradient-text">Uma operação.</span>
        </h2>
        <div class="mt-8 space-y-5">
          <div class="glass rounded-2xl p-5 border border-white/5">
            <div class="font-mono text-[10px] uppercase tracking-wider text-accent-blue mb-1">Camada 1</div>
            <div class="font-display text-xl font-semibold text-ink-100">Inteligência — Claude</div>
            <p class="text-ink-400 text-[15px] mt-1 leading-relaxed">
              Lê dado, raciocina, escreve código, executa ferramentas.
            </p>
          </div>
          <div class="glass rounded-2xl p-5 border border-white/5">
            <div class="font-mono text-[10px] uppercase tracking-wider text-accent-violet mb-1">Camada 2</div>
            <div class="font-display text-xl font-semibold text-ink-100">Interface — Lovable</div>
            <p class="text-ink-400 text-[15px] mt-1 leading-relaxed">
              Texto vira dashboard, CRM, app interno. Conectado em tempo real à sua planilha.
            </p>
          </div>
          <div class="glass rounded-2xl p-5 border border-white/5">
            <div class="font-mono text-[10px] uppercase tracking-wider text-accent-mint mb-1">Camada 3</div>
            <div class="font-display text-xl font-semibold text-ink-100">Blindagem — Aikido</div>
            <p class="text-ink-400 text-[15px] mt-1 leading-relaxed">
              Monitora tudo que foi construído. Bloqueia o que não devia entrar.
            </p>
          </div>
        </div>
      </div>
      <div class="relative h-[500px] rounded-3xl overflow-hidden border border-white/5">
        <HubScene client:only="react" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative max-w-5xl mx-auto px-6 py-24 text-center">
    <h2 class="font-display text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight">
      Comece pelo <span class="gradient-text">começo.</span>
    </h2>
    <p class="mt-6 text-lg text-ink-300 max-w-2xl mx-auto">
      Não é curso linear. Cada módulo se sustenta sozinho. Mas a primeira lição abre tudo.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href="/modulos/m00"
        class="inline-flex items-center gap-2 rounded-full px-6 py-3 bg-gradient-to-r from-accent-blue to-accent-violet text-ink-100 font-medium hover:brightness-110 transition"
      >
        Abrir Módulo 00 <span class="font-mono">→</span>
      </a>
    </div>
  </section>
</Base>
