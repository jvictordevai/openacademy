---
import Base from '../layouts/Base.astro';
import { OrbitScene } from '../scenes/OrbitScene';

const company = {
  name: 'Distribuidora Aurora Ltda.',
  desc: 'Distribuidora B2B fictícia de materiais elétricos para construtoras, instaladoras e revendas.',
  faturamento: '~R$ 2,1M/mês',
  funcionarios: 87,
  vendedores: 11,
  clientes: 380,
  filial: 'Cotia/SP + Campinas/SP',
};

const datasets = [
  {
    id: 'vendas',
    title: 'Planilha de Vendas — 2024 + 2025',
    file: '/materiais/vendas-aurora-2024-2025.xlsx',
    size: '4,1 MB',
    rows: '~37.000 linhas',
    color: 'oklch(72% 0.18 250)',
    sheets: [
      { name: 'Vendedores', desc: '11 vendedores · regiões · metas · comissões' },
      { name: 'Clientes', desc: '380 clientes · segmento · cidade · limite de crédito' },
      { name: 'Produtos', desc: '40 SKUs em 4 categorias com custo, preço de tabela e fornecedor' },
      { name: 'Vendas', desc: '~12.700 pedidos · 24 meses · com sazonalidade, desconto, margem por linha' },
    ],
    anomalies: [
      'Vipar Engenharia concentra ~23% da receita anual',
      'Marcos Tavares: ticket médio R$ 1,8k vs equipe R$ 3,1k (42% abaixo)',
      'Categoria Iluminação LED: margem caindo de ~28% para ~16% em 24 meses',
      'Sazonalidade clara em mar/abr e set/out (pico) · jan/dez (vale)',
      'Custo Prysmian +23% nos últimos 6 meses (impacto em CMV)',
    ],
  },
  {
    id: 'financeiro',
    title: 'Planilha Financeira — 2025',
    file: '/materiais/financeiro-aurora-2025.xlsx',
    size: '1,2 MB',
    rows: '~8.500 linhas',
    color: 'oklch(82% 0.14 165)',
    sheets: [
      { name: 'DRE_Mensal', desc: 'DRE de 12 meses · 19 linhas por mês · receita, CMV, despesas, EBITDA, lucro' },
      { name: 'Fluxo_Caixa', desc: '180 dias diários · entradas, saídas, saldo acumulado, conta bancária' },
      { name: 'Contas_Receber', desc: '~6.500 títulos · aging · forma de pagamento · status' },
      { name: 'Contas_Pagar', desc: '~450 títulos · 14 fornecedores principais · categorização de despesa' },
    ],
    anomalies: [
      'Frete saída cresce de 2,1% para 3,8% da receita líquida (ralo silencioso)',
      'Despesas financeiras +41% no ano (capital de giro caro)',
      'Margem bruta cai de 26% para 21%',
      'Aging: 38% dos títulos vencidos há mais de 30 dias',
      'Atraso médio de pagamento cresce de 11d para 26d em 8 meses',
    ],
  },
];

const csvFiles = [
  { name: 'vendedores.csv', size: '720 B' },
  { name: 'clientes.csv', size: '48 KB' },
  { name: 'produtos.csv', size: '4 KB' },
  { name: 'vendas.csv', size: '7,7 MB' },
  { name: 'dre.csv', size: '10 KB' },
  { name: 'fluxo_caixa.csv', size: '104 KB' },
  { name: 'contas_receber.csv', size: '2,2 MB' },
  { name: 'contas_pagar.csv', size: '43 KB' },
];

const useCases = [
  {
    title: 'Demo ao vivo de análise',
    steps: [
      'Baixe a planilha de vendas ou financeiro',
      'Suba no Claude.ai (Pro com code execution ativo)',
      'Cole o prompt-mestre da biblioteca',
      'Veja a análise sair em 30-60 segundos',
    ],
  },
  {
    title: 'Construir dashboard no Lovable',
    steps: [
      'Suba as planilhas no Google Drive',
      'No Lovable, conecte Google Sheets',
      'Cole o prompt do Claude para gerar UI',
      'Dashboard ativo conectado em tempo real',
    ],
  },
  {
    title: 'Evoluir para ERP simples',
    steps: [
      'Use as planilhas como dados-base',
      'Lovable + Supabase como camada de aplicação',
      'Adicione módulos: estoque, NF-e, cobrança',
      'Veja o módulo M08 sobre orquestração',
    ],
  },
];
---

<Base
  title="Materiais — Planilhas de Demonstração"
  description="Planilhas fictícias da Distribuidora Aurora para uso em demos com Claude, Lovable e ERP. Dados realistas com padrões plantados."
>
  <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] focus:bg-accent-blue focus:text-ink-100 focus:px-4 focus:py-2 focus:rounded-lg focus:font-medium">
    Pular para o conteúdo
  </a>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-30">
      <OrbitScene client:only="react" />
    </div>
    <div class="absolute inset-0 z-[1] grid-bg pointer-events-none"></div>
    <div class="absolute inset-0 z-[2] [background:radial-gradient(ellipse_at_center,transparent_30%,oklch(10%_0.02_260)_100%)] pointer-events-none"></div>

    <div id="content" class="relative z-10 max-w-6xl mx-auto px-6 pt-20 pb-12">
      <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-3">
        Materiais · Fictícios · Uso livre
      </div>
      <h1 class="font-display text-5xl md:text-7xl font-bold leading-[0.95] tracking-tight">
        Planilhas de <span class="gradient-text">demo.</span>
      </h1>
      <p class="mt-6 text-xl text-ink-300 max-w-2xl leading-relaxed">
        Empresa fictícia com dados realistas para apresentações, demos com Claude e construção de
        dashboards no Lovable. Padrões interessantes plantados — pra IA encontrar.
      </p>
    </div>
  </section>

  <!-- empresa ficticia card -->
  <section class="relative max-w-6xl mx-auto px-6 pb-12">
    <div class="glass-strong rounded-3xl p-8 border border-white/10">
      <div class="grid md:grid-cols-[1.4fr_1fr] gap-8 items-start">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent-blue mb-2">
            Empresa fictícia
          </div>
          <h2 class="font-display text-3xl font-bold text-ink-100 mb-3">{company.name}</h2>
          <p class="text-ink-300 leading-relaxed text-[15px]">{company.desc}</p>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {[
            { label: 'Faturamento', value: company.faturamento },
            { label: 'Funcionários', value: String(company.funcionarios) },
            { label: 'Vendedores', value: String(company.vendedores) },
            { label: 'Clientes ativos', value: String(company.clientes) },
            { label: 'Unidades', value: company.filial, full: true },
          ].map((stat) => (
            <div class={`rounded-2xl border border-white/10 bg-white/[0.02] p-4 ${stat.full ? 'col-span-2' : ''}`}>
              <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400 mb-1">
                {stat.label}
              </div>
              <div class="font-display text-lg font-semibold text-ink-100">{stat.value}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- downloads -->
  <section class="relative max-w-6xl mx-auto px-6 pb-12">
    <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-5">
      Downloads · formato .xlsx
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {
        datasets.map((d) => (
          <article class="glass rounded-3xl p-7 border border-white/5 hover:border-white/10 transition relative overflow-hidden">
            <div
              class="absolute -top-12 -right-12 w-48 h-48 rounded-full blur-3xl opacity-20"
              style={`background:${d.color}`}
            />
            <div class="relative">
              <h3 class="font-display text-2xl font-semibold text-ink-100 leading-tight">
                {d.title}
              </h3>
              <div class="mt-2 flex flex-wrap gap-2 font-mono text-[10px] uppercase tracking-wider text-ink-400">
                <span>{d.size}</span>
                <span class="text-ink-700">·</span>
                <span>{d.rows}</span>
              </div>

              <a
                href={d.file}
                download
                class="mt-5 inline-flex items-center gap-2 rounded-full px-5 py-2.5 bg-gradient-to-r from-accent-blue to-accent-violet text-ink-100 font-medium hover:brightness-110 transition"
              >
                Baixar .xlsx
                <span class="font-mono">↓</span>
              </a>

              <div class="mt-6">
                <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400 mb-2">
                  Abas
                </div>
                <ul class="space-y-1.5 pl-0 list-none">
                  {d.sheets.map((s) => (
                    <li class="text-[14px] text-ink-200 leading-relaxed">
                      <strong class="text-ink-100">{s.name}</strong>
                      <span class="text-ink-400"> — {s.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-5 pt-5 border-t border-white/5">
                <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent-mint mb-2">
                  Padrões plantados
                </div>
                <ul class="space-y-1.5 pl-0 list-none">
                  {d.anomalies.map((a) => (
                    <li class="text-[13px] text-ink-300 flex gap-2">
                      <span class="text-accent-mint font-mono">→</span>
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CSVs -->
  <section class="relative max-w-6xl mx-auto px-6 pb-12">
    <details class="glass rounded-3xl p-7 border border-white/5">
      <summary class="cursor-pointer list-none flex items-center justify-between [&::-webkit-details-marker]:hidden">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent-blue mb-1">
            Versão CSV
          </div>
          <div class="font-display text-xl font-semibold text-ink-100">
            Arquivos individuais em CSV (uso programático)
          </div>
        </div>
        <span class="font-mono text-xs text-ink-400 group-open:rotate-180 transition">⌄</span>
      </summary>
      <div class="mt-5 pt-5 border-t border-white/5 grid sm:grid-cols-2 lg:grid-cols-4 gap-2">
        {
          csvFiles.map((c) => (
            <a
              href={`/materiais/csv/${c.name}`}
              download
              class="rounded-xl border border-white/10 bg-white/[0.02] hover:border-white/20 hover:bg-white/[0.05] transition p-3 flex items-center justify-between"
            >
              <span class="font-mono text-[12px] text-ink-200 truncate">{c.name}</span>
              <span class="font-mono text-[10px] text-ink-400 shrink-0 ml-2">{c.size}</span>
            </a>
          ))
        }
      </div>
    </details>
  </section>

  <!-- como usar -->
  <section class="relative max-w-6xl mx-auto px-6 pb-16">
    <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-5">
      Casos de uso
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      {
        useCases.map((u, i) => (
          <div class="glass rounded-2xl p-6 border border-white/5 relative">
            <div class="font-mono text-3xl font-bold text-accent-blue/40 mb-3">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="font-display text-lg font-semibold text-ink-100 leading-tight mb-3">
              {u.title}
            </h3>
            <ol class="space-y-1.5 pl-0 list-none">
              {u.steps.map((s, idx) => (
                <li class="flex gap-2 text-[13px] text-ink-300">
                  <span class="text-accent-blue font-mono text-xs mt-0.5">{idx + 1}.</span>
                  <span>{s}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <!-- disclaimer -->
  <section class="relative max-w-4xl mx-auto px-6 pb-20">
    <div class="rounded-2xl border border-accent-ember/25 bg-accent-ember/[0.04] p-6">
      <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent-ember mb-2">
        Importante
      </div>
      <p class="text-ink-200 text-[15px] leading-relaxed">
        Dados <strong>100% fictícios</strong>. Empresa, CNPJs, clientes e vendedores não existem.
        Padrões plantados intencionalmente para fins didáticos — uma planilha real não vem com
        anomalias tão limpas e fáceis de detectar. Em produção, espere ruído.
      </p>
    </div>
  </section>
</Base>
