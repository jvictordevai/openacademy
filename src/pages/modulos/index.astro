---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { FlowScene } from '../../scenes/FlowScene';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const allLessons = await getCollection('lessons');

const moduleStats = modules.map((m) => ({
  ...m.data,
  lessonCount: allLessons.filter((l) => l.data.module === m.data.id).length,
}));
---

<Base title="Módulos">
  <section class="relative min-h-[40vh] overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-50">
      <FlowScene client:only="react" />
    </div>
    <div class="absolute inset-0 z-[1] grid-bg pointer-events-none"></div>
    <div class="absolute inset-0 z-[2] [background:radial-gradient(ellipse_at_center,transparent_30%,oklch(10%_0.02_260)_100%)] pointer-events-none"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 pt-24 pb-16">
      <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-3">
        Trilha completa
      </div>
      <h1 class="font-display text-5xl md:text-7xl font-bold leading-[0.95] tracking-tight">
        <span class="gradient-text">Módulos.</span>
      </h1>
      <p class="mt-6 text-lg text-ink-300 max-w-2xl leading-relaxed">
        Cada módulo é independente. Você pode pular pra onde dói mais — e voltar quando quiser.
      </p>
    </div>
  </section>

  <section class="relative max-w-6xl mx-auto px-6 pb-24">
    <div class="grid md:grid-cols-2 gap-5">
      {
        moduleStats.map((m) => (
          <a
            href={`/modulos/${m.id}`}
            class="group glass rounded-3xl p-7 border border-white/5 hover:border-white/10 transition relative overflow-hidden"
          >
            <div
              class="absolute -top-16 -right-16 w-56 h-56 rounded-full blur-3xl opacity-20 group-hover:opacity-40 transition"
              style={`background:${m.color}`}
            />
            <div class="relative">
              <div class="flex items-center justify-between mb-5">
                <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-400">
                  {String(m.order).padStart(2, '0')} · Módulo
                </span>
                <span
                  class="font-mono text-[10px] uppercase tracking-wider px-3 py-1 rounded-full glass"
                  style={`color:${m.color}`}
                >
                  {m.lessonCount} {m.lessonCount === 1 ? 'lição' : 'lições'}
                </span>
              </div>
              <h2 class="font-display text-3xl font-semibold text-ink-100 leading-tight">
                {m.title}
              </h2>
              <p class="mt-3 text-ink-400 text-[15px] leading-relaxed">{m.description}</p>
              <div class="mt-6 inline-flex items-center gap-2 text-sm text-ink-300 group-hover:text-ink-100 transition">
                Abrir módulo <span class="font-mono">→</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
