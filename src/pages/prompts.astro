---
import Base from '../layouts/Base.astro';
import { OrbitScene } from '../scenes/OrbitScene';
import { prompts, promptCategories } from '../lib/prompts';

const categoryColors: Record<string, string> = {
  comercial: 'oklch(72% 0.18 250)',
  financeiro: 'oklch(82% 0.14 165)',
  operacional: 'oklch(70% 0.22 295)',
  marketing: 'oklch(78% 0.16 35)',
  juridico: 'oklch(74% 0.18 10)',
  rh: 'oklch(78% 0.16 35)',
  pessoal: 'oklch(70% 0.22 295)',
};
---

<Base
  title="Biblioteca de Prompts"
  description="Prompts prontos para empresário usar segunda-feira: análise comercial, financeira, jurídica, marketing, RH."
>
  <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] focus:bg-accent-blue focus:text-ink-100 focus:px-4 focus:py-2 focus:rounded-lg focus:font-medium">
    Pular para o conteúdo
  </a>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-50">
      <OrbitScene client:only="react" />
    </div>
    <div class="absolute inset-0 z-[1] grid-bg pointer-events-none"></div>
    <div class="absolute inset-0 z-[2] [background:radial-gradient(ellipse_at_center,transparent_30%,oklch(10%_0.02_260)_100%)] pointer-events-none"></div>

    <div id="content" class="relative z-10 max-w-5xl mx-auto px-6 pt-20 pb-16">
      <div class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent-blue mb-3">
        {prompts.length} prompts curados
      </div>
      <h1 class="font-display text-5xl md:text-7xl font-bold leading-[0.95] tracking-tight">
        Biblioteca de <span class="gradient-text">prompts.</span>
      </h1>
      <p class="mt-6 text-xl text-ink-300 max-w-2xl leading-relaxed">
        Copia, cola, ajusta o contexto. Todos testados com casos reais de empresa.
        Cole no Claude.ai e veja a diferença em 30 segundos.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-8">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtros de categoria">
      <button
        type="button"
        data-filter="all"
        class="filter-btn rounded-full px-4 py-2 text-[12px] font-mono uppercase tracking-wider border border-accent-blue/40 bg-accent-blue/10 text-accent-blue"
      >
        Todos
      </button>
      {
        promptCategories.map((c) => (
          <button
            type="button"
            data-filter={c.id}
            class="filter-btn rounded-full px-4 py-2 text-[12px] font-mono uppercase tracking-wider border border-white/10 bg-white/[0.02] text-ink-300 hover:border-white/20 hover:text-ink-100 transition"
          >
            {c.label}
          </button>
        ))
      }
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div class="grid gap-4">
      {
        prompts.map((p) => (
          <article
            class="prompt-card glass rounded-3xl p-7 border border-white/5"
            data-category={p.category}
          >
            <header class="flex items-start justify-between gap-5 mb-3">
              <div>
                <div
                  class="font-mono text-[10px] uppercase tracking-[0.2em] mb-2"
                  style={`color:${categoryColors[p.category]}`}
                >
                  {promptCategories.find((c) => c.id === p.category)?.label ?? p.category}
                </div>
                <h2 class="font-display text-2xl font-semibold text-ink-100 leading-tight">
                  {p.title}
                </h2>
                <p class="mt-2 text-ink-300 text-[15px] leading-relaxed">{p.goal}</p>
              </div>
              <button
                type="button"
                class="copy-btn shrink-0 glass rounded-full px-4 py-2 text-[11px] font-mono uppercase tracking-wider text-ink-200 hover:text-ink-100 transition"
                data-prompt={p.template}
                aria-label={`Copiar prompt: ${p.title}`}
              >
                Copiar
              </button>
            </header>

            <details class="group rounded-2xl">
              <summary class="cursor-pointer list-none flex items-center gap-2 py-2 text-sm text-ink-400 hover:text-ink-200 transition">
                <span class="font-mono text-[10px] uppercase tracking-wider">
                  Ver template
                </span>
                <span class="chevron transition-transform group-open:rotate-90 text-xs">›</span>
              </summary>
              <pre class="mt-3 max-h-[420px] overflow-y-auto no-scrollbar bg-ink-950/60 border border-white/10 rounded-2xl p-5 text-[12.5px] leading-relaxed text-ink-200 font-mono whitespace-pre-wrap"><code set:text={p.template} /></pre>
            </details>

            {p.notes && (
              <p class="mt-4 text-[13px] text-ink-400 italic">{p.notes}</p>
            )}
          </article>
        ))
      }
    </div>
  </section>
</Base>

<script>
  // Category filtering
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.prompt-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      filterButtons.forEach((b) => {
        b.classList.remove('border-accent-blue/40', 'bg-accent-blue/10', 'text-accent-blue');
        b.classList.add('border-white/10', 'bg-white/[0.02]', 'text-ink-300');
      });
      btn.classList.remove('border-white/10', 'bg-white/[0.02]', 'text-ink-300');
      btn.classList.add('border-accent-blue/40', 'bg-accent-blue/10', 'text-accent-blue');

      cards.forEach((card) => {
        const cat = card.dataset.category;
        card.style.display = filter === 'all' || cat === filter ? 'block' : 'none';
      });
    });
  });

  // Copy to clipboard
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const prompt = btn.dataset.prompt ?? '';
      try {
        await navigator.clipboard.writeText(prompt);
        const original = btn.textContent;
        btn.textContent = '✓ Copiado';
        btn.classList.add('text-accent-mint');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('text-accent-mint');
        }, 2000);
      } catch (err) {
        console.error('Copy failed', err);
      }
    });
  });
</script>
